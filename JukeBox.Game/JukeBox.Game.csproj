<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JukeBox.Resources\JukeBox.Resources.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Framework" Version="2026.807.0" />
    <!-- osu!lazer as a library: real gameplay renderers for all four rulesets.
         2026.730.0 is the newest release; its ppy.osu.Framework floor (2026.728.1) is satisfied
         by (and overridden to) our explicit 2026.807.0 reference above. -->
    <PackageReference Include="ppy.osu.Game" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.730.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.730.0" />
    <!-- Default skin assets (textures/samples/fonts). CC-BY-NC licensed — see docs/ATTRIBUTION.md. -->
    <PackageReference Include="ppy.osu.Game.Resources" Version="2026.710.0" />
    <!-- Discord rich presence (Lachee's discord-rpc-csharp), MIT. Pinned to the same version
         osu!lazer's own osu.Desktop uses; 1.6.x carries the join-invite bug ppy flagged, and we
         want no part of the invite surface regardless. ActivityType (Listening/Watching) is
         already present in this version — see JukeBox.Game/Presence. -->
    <PackageReference Include="DiscordRichPresence" Version="1.5.0.51" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JukeBox.Game.Tests" />
  </ItemGroup>
</Project>
